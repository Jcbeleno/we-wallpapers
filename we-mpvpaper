def load_items():
    compat = read_json(COMPAT_DB, {})
    raw = {}
    for wdir in workshop_dirs():
        for d in sorted(wdir.iterdir()):
            data = read_json(d / "project.json", None)
            if isinstance(data, dict):
                raw[d.name] = (d, data, "workshop")
    for odir in official_dirs():
        for d in sorted(odir.iterdir()):
            data = read_json(d / "project.json", None)
            if isinstance(data, dict):
                raw[f"official-{d.name}"] = (d, data, "official")

    items = []
    for item_id, (d, data, source) in raw.items():
        kind = str(data.get("type", "")).lower()
        file = d / data["file"] if data.get("file") else None
        preview = d / data["preview"] if data.get("preview") else None
        if not kind and file:
            kind = KIND_EXT.get(file.suffix.lower(), "")
        if kind != "video" and file and file.suffix.lower() in VIDEO_EXT:
            kind = "video"
        props = (data.get("general") or {}).get("properties") or {}
        # El motor acepta un id del Workshop o la ruta de la carpeta.
        target, preset, folder = (str(d) if source == "official" else item_id), {}, d
        # Preset: configuración guardada de otro fondo (dependency) con sus valores.
        dep = str(data.get("dependency") or "")
        if not kind and dep in raw and isinstance(data.get("preset"), dict):
            parent = raw[dep][1]
            kind = str(parent.get("type", "")).lower()
            target, folder = dep, raw[dep][0]
            props = (parent.get("general") or {}).get("properties") or {}
            preset = {k: v for k, v in data["preset"].items() if k in props}
            if kind == "video" and parent.get("file"):
                file = raw[dep][0] / parent["file"]
        props = {k: v for k, v in props.items() if isinstance(v, dict)}
        c = compat.get(target)
        shot = CACHE_DIR / f"shot-{item_id}.png"
        if not shot.is_file():
            shot = CACHE_DIR / f"shot-{target}.png"
        items.append({
            "id": item_id,
            "target": target,
            "source": source,
            "preset": preset,
            "dir": d,
            "folder": folder,  # la del fondo de verdad (en un preset, la de su dependency)
            "title": data.get("title") or item_id,
            "type": kind or "?",
            "file": file if file and file.is_file() else None,
            "preview": preview if preview and preview.is_file() else None,
            "shot": shot if shot.is_file() else None,
            "tags": data.get("tags") or [],
            "added": d.stat().st_mtime,  # Steam la rehace al bajar o actualizar el fondo
            # None (sin probar), "ok", "partial" (funciona a medias: ver issues) o "fail"
            "compat": None if c is None else c.get("status") or ("ok" if c.get("ok") else "fail"),
            "issues": [] if c is None else c.get("issues") or [],
            "projection": None if c is None else c.get("projection"),
            "props": props,
        })
    # Estado y captura del motor que de verdad lo va a dibujar (tests/compare_engines.py, revisado a
    # mano en review.json). Sin prueba de ese motor se queda lo de compat-test (linux-wallpaperengine).
    engines = read_json(CACHE_DIR / "engines.json", {})
    for item in items:
        item["compat_test"] = (item["compat"], item["issues"], item["shot"])  # lo de compat-test, sin motor
        engine_status(item, engines)
    # Los que funcionan primero, luego los parciales y al final los que no.
    items.sort(key=lambda i: (i["compat"] == "fail" or not playable(i), i["compat"] == "partial",
                              i["title"].lower()))
    return items


