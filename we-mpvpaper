def ws_description(item_id):
    """Descripción completa (la búsqueda solo trae un extracto). Sin BBCode."""
    body = http_get("https://api.steampowered.com/ISteamRemoteStorage/GetPublishedFileDetails/v1/",
                    urllib.parse.urlencode({"itemcount": 1, "publishedfileids[0]": item_id}).encode())
    d = json.loads(body)["response"]["publishedfiledetails"][0]
    text = re.sub(r"\[/?[a-z0-9*]+(?:=[^\]]*)?\]", "", str(d.get("description") or ""), flags=re.I)
    return re.sub(r"\n{3,}", "\n\n", text).strip()


def ws_preview(item):
    """Vista previa del Workshop (casi siempre un GIF animado de 256 px), cacheada."""
    url = item["preview_url"]
    out = UGC_DIR / f"{item['id']}-{hashlib.sha1(url.encode()).hexdigest()[:10]}"
    if not out.is_file():
        UGC_DIR.mkdir(parents=True, exist_ok=True)
        tmp = UGC_DIR / f"{out.name}.{threading.get_ident()}.tmp"
        tmp.write_bytes(http_get(url))
        tmp.replace(out)
    return out


def short_num(n):
    for div, suffix in ((1e6, " M"), (1e3, " mil")):
        if n >= div:
            return f"{n / div:.1f}".rstrip("0").rstrip(".").replace(".", ",") + suffix
    return str(n)


class SteamError(Exception):
    def __str__(self):
        msg = super().__str__()
        return "Steam no está abierto" if msg == "steam-not-running" else msg


class SteamBridge:
    """Proceso steam_ugc.py que habla con el cliente de Steam. Se arranca al necesitarlo y
    se cierra tras un rato sin uso: mientras vive, Steam muestra «Jugando a Wallpaper Engine».
    `call` bloquea: usarlo desde hilos."""
    IDLE_SECS = 90

    def __init__(self):
        self.proc = None
        self.lock = threading.Lock()
        self.last = 0.0

    def call(self, cmd, **args):
        with self.lock:
            try:
                if not self.proc or self.proc.poll() is not None:
                    self.proc = subprocess.Popen(
                        [sys.executable, "-I", str(STEAM_BRIDGE)], stdin=subprocess.PIPE,
                        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, cwd=str(HOME))
                    hello = self._read()
                    if not hello.get("ok"):
                        self.proc = None
                        raise SteamError(hello.get("error"))
                self.proc.stdin.write(json.dumps({"cmd": cmd, **args}) + "\n")
                self.proc.stdin.flush()
                res = self._read()
            except OSError as e:
                self.proc = None
                raise SteamError(f"el puente con Steam falló ({e})") from e
            self.last = time.monotonic()
        if not res.get("ok"):
            raise SteamError(res.get("error"))
        return res

    def _read(self):
        try:
            return json.loads(self.proc.stdout.readline())
        except ValueError:
            return {"ok": False, "error": "el puente con Steam se cerró"}

    def idle(self):
        return self.proc is not None and time.monotonic() - self.last > self.IDLE_SECS

    def close(self):
        with self.lock:
            proc, self.proc = self.proc, None
        if proc and proc.poll() is None:
            try:
                proc.stdin.close()
                proc.wait(3)
            except (OSError, subprocess.TimeoutExpired):
                proc.kill()


