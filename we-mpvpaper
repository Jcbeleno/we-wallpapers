    def engine_row(self, item):
        """Motor de este fondo: el automático es waywallen salvo lo que solo funciona en el otro."""
        other = "mpvpaper" if item["type"] == "video" else "linux-wallpaperengine"
        keys = ["", "ww", "lwe"]
        own = read_json(ENGINES_FILE, {}).get(item["id"], "")
        auto = "waywallen" if engine_for({**item, "id": None}) == "ww" else other
        row = Adw.ComboRow(title="Motor", use_subtitle=True, model=Gtk.StringList.new(
            [f"Automático ({auto})", "waywallen", other]), selected=keys.index(own) if own in keys else 0)
        if not waywallen_available():
            row.set_sensitive(False)
            row.set_subtitle(f"{other} (waywallen no está instalado)")

        def changed(*_):
            data = read_json(ENGINES_FILE, {})
            data.pop(item["id"], None)
            if keys[row.get_selected()]:
                data[item["id"]] = keys[row.get_selected()]
            write_json(ENGINES_FILE, data)
            engine_status(item)
            GLib.idle_add(self.show_detail, item)  # estado y captura del otro motor (no dentro del propio combo)
            if not item["preset"] and active_ids().get(self.item_key(item)):
                self.apply(item, from_sidebar=True)  # en pantalla: se pasa al otro motor ya
        row.connect("notify::selected", changed)
        return row

    def mute_row(self, item):
        """Silencio propio del fondo. Se guarda solo si difiere del de Ajustes."""
        general = engine_config()["mute"]
        own = saved_mute(item["id"])
        row = Adw.SwitchRow(title="Silenciar este fondo", active=general if own is None else own)

        def subtitle():
            follows = saved_mute(item["id"]) is None
            row.set_subtitle("Como en Ajustes" if follows else
                             "Solo este fondo" if row.get_active() else
                             f"Solo este fondo · volumen {engine_config()['volume']} %")

        def toggled(*_):
            save_mute(item["id"], None if row.get_active() == general else row.get_active())
            subtitle()
            self.live_apply(item)
        subtitle()
        row.connect("notify::active", toggled)
        return row

