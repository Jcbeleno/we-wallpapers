def nmsg(*args, check=True):
    return subprocess.run(["noctalia", "msg", *args], check=check, capture_output=True,
                          text=True, timeout=20)


def enabled_plugins():
    if not shutil.which("noctalia"):
        return set()
    try:
        out = nmsg("plugins", "list", check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return set()
    return {l.split()[0] for l in out.splitlines() if l.rstrip().endswith(" enabled")}


def expand(assign, outs):
    """Convierte una asignación "*" en una por salida."""
    assign = dict(assign)
    if "*" in assign:
        value = assign.pop("*")
        for o in outs:
            assign.setdefault(o, value)
    return assign


def targets(connector, outs):
    return set(outs) if connector == "*" else {connector}


def set_mpv_assignments(new):
    """El plugin noctalia/mpvpaper solo lee assignments.json al arrancar: se reinicia."""
    if not new:
        nmsg("plugin", f"{MPV_PLUGIN}:service", "all", "clear-all")
        return
    nmsg("plugins", "disable", MPV_PLUGIN)
    state = {"assignments": new, "lastAssignments": new,
             "launchedAsSystemd": {k: False for k in new}}
    MPV_STATE.parent.mkdir(parents=True, exist_ok=True)
    MPV_STATE.write_text(json.dumps(state, ensure_ascii=False))
    nmsg("plugins", "enable", MPV_PLUGIN)


def release_mpv(connector, outs, plugins):
    """Quita los videos de mpvpaper de las salidas indicadas."""
    if MPV_PLUGIN in plugins:
        cur = read_json(MPV_STATE, {}).get("assignments", {})
        if not cur:
            return
        new = {} if connector == "*" else expand(cur, outs)
        for o in targets(connector, outs):
            new.pop(o, None)
        if new != cur:
            set_mpv_assignments(new)
    else:
        subprocess.run(["pkill", "-x", "mpvpaper"])


def release_we(connector, plugins):
    if WE_PLUGIN in plugins:
        if read_json(WE_STATE, {}).get("assignments"):
            nmsg("plugin", f"{WE_PLUGIN}:service", "all", "clear", "" if connector == "*" else connector)
    else:
        subprocess.run(["pkill", "-f", "linux-wallpaperengine --screen-root"])


# Ajuste de los videos como propiedades de mpv. El plugin noctalia/mpvpaper siempre arranca
# con panscan=1.0 (rellenar); el resto se pone por el socket IPC que abre por cada salida.
MPV_SCALING = {"fill": {"panscan": 1.0, "keepaspect": True}, "fit": {"panscan": 0.0, "keepaspect": True},
               "stretch": {"panscan": 0.0, "keepaspect": False}}


def mpv_scaling(scaling):
    return MPV_SCALING.get(scaling or engine_config()["scaling"], MPV_SCALING["fill"])


def set_video_scaling(connector, scaling, since=0.0, wait=8.0):
    """Manda el ajuste al mpv de esa salida. since: espera a un socket creado después (el plugin
    reinicia mpvpaper al cambiar de video y el socket viejo puede seguir ahí un momento)."""
    path = MPV_STATE.parent / f"ipc-{re.sub(r'[^A-Za-z0-9-]', '_', connector)}.sock"
    end = time.time() + wait
    while time.time() < end:
        try:
            if path.stat().st_ctime >= since:
                with socket.socket(socket.AF_UNIX) as s:
                    s.settimeout(1)
                    s.connect(str(path))
                    for key, value in mpv_scaling(scaling).items():
                        s.sendall((json.dumps({"command": ["set_property", key, value]}) + "\n").encode())
                        s.recv(4096)  # sin esperar la respuesta, cerrar perdía el segundo comando
                return True
        except OSError:
            pass
        time.sleep(0.25)
    return False


def apply_video(path, connector, scaling=""):
    plugins, outs = enabled_plugins(), outputs()
    release_ww(connector, outs)
    release_we(connector, plugins)
    path = str(path)
    if MPV_PLUGIN in plugins:
        cur = read_json(MPV_STATE, {}).get("assignments", {})
        new = {"*": path} if connector == "*" else {**expand(cur, outs), connector: path}
        since = time.time()
        set_mpv_assignments(new)
        set_video_scaling(connector, scaling, since)
        return "Aplicado (video, vía Noctalia)"
    subprocess.run(["pkill", "-x", "mpvpaper"])
    opts = " ".join(f"{k}={'yes' if v is True else 'no' if v is False else v}" for k, v in mpv_scaling(scaling).items())
    subprocess.Popen(["mpvpaper", "-o", f"loop-file=inf {opts} no-audio hwdec=auto",
                      connector, path], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return "Aplicado con mpvpaper"


def apply_scene(item_id, connector, props, kind="scene", scaling="", mute=None):
    plugins, outs = enabled_plugins(), outputs()
    bg = item_id
    release_ww(connector, outs)
    release_mpv(connector, outs, plugins)
    if WE_PLUGIN in plugins:
        payload = json.dumps({"connector": connector, "id": bg, "props": props, "kind": kind,
                              "scaling": scaling or None, "mute": mute}, ensure_ascii=False)
        nmsg("plugin", f"{WE_PLUGIN}:service", "all", "set", payload)
        return "Aplicado (linux-wallpaperengine, vía Noctalia)"
    subprocess.run(["pkill", "-f", "linux-wallpaperengine --screen-root"])
    # Versión parcheada (~/Proyectos/linux-wallpaperengine, rama web-fixes) si existe.
    cmd = [shutil.which("linux-wallpaperengine-web") or "linux-wallpaperengine"]
    for o in sorted(targets(connector, outs)) or ["*"]:
        # --scaling vale para la --screen-root anterior: detrás de cada una (ver el plugin)
        cmd += ["--screen-root", o, "--bg", bg] + (["--scaling", scaling] if scaling else [])
    for k, v in props.items():
        cmd += ["--set-property", f"{k}={int(v) if isinstance(v, bool) else v}"]
    subprocess.Popen(cmd + ["--layer", "background"] + ([] if mute is False else ["--silent"]), start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, cwd=str(HOME))
    return "Aplicado con linux-wallpaperengine"


def engine_status(item, engines=None):
    """Estado, motivo y captura del fondo con el motor que lo va a dibujar."""
    item["compat"], item["issues"], item["shot"] = item["compat_test"]
    engine = engine_for(item)
    tested = (read_json(CACHE_DIR / "engines.json", {}) if engines is None else engines).get(
        item["target"], {}).get(engine)
    if not tested:
        return
    name = "waywallen" if engine == "ww" else "linux-wallpaperengine"
    item["compat"] = tested["status"]
    item["issues"] = ([tested["note"]] if tested.get("note") else [] if tested["status"] == "ok" else
                      [f"Se ve, pero {name} registró errores: puede faltar algún efecto"]
                      if tested["status"] == "partial" else [f"No se dibujó en la prueba con {name}"])
    if tested.get("shot") and Path(tested["shot"]).is_file():
        item["shot"] = Path(tested["shot"])


def waywallen_available():
    return waywallen is not None and shutil.which("waywallen-layer-shell") is not None and any(
        (root / "app/org.waywallen.waywallen").is_dir()
        for root in (HOME / ".local/share/flatpak", Path("/var/lib/flatpak")))


def engine_for(item):
    """waywallen es el motor principal (mejores partículas y detalle, dibuja también las escenas 3D);
    linux-wallpaperengine o mpvpaper solo para lo que waywallen no puede, o si se elige a mano."""
    own = read_json(ENGINES_FILE, {}).get(item["id"])
    if own in ("ww", "lwe"):
        return own if own == "lwe" or waywallen_available() else "lwe"
    # lwe-only.json guarda el id del Workshop o el nombre de la carpeta de un fondo oficial
    if not waywallen_available() or Path(str(item["target"])).name in read_json(LWE_ONLY_FILE, []):
        return "lwe"
    return "ww"


def host_wallpaper(connectors, visible):
    """Muestra u oculta el fondo de Noctalia, que en la capa de fondo tapa la superficie de waywallen."""
    for o in connectors:
        nmsg("plugin", f"{WE_PLUGIN}:service", "all", "host-show" if visible else "host-hide", o, check=False)


def apply_waywallen(folder, connector, key, props, scaling="", mute=None):
    plugins, outs = enabled_plugins(), outputs()
    release_mpv(connector, outs, plugins)
    release_we(connector, plugins)
    if not waywallen.ensure_running():
        raise RuntimeError("waywallen no arranca (systemctl --user status waywallen)")
    waywallen.apply(folder, connector, scaling or engine_config()["scaling"], props)
    waywallen.set_muted(engine_config()["mute"] if mute is None else mute)
    host_wallpaper(targets(connector, outs), False)
    cur = read_json(WW_STATE, {})
    write_json(WW_STATE, {**({} if connector == "*" else expand(cur, outs)),
                          **{o: key for o in targets(connector, outs)}})
    return "Aplicado con waywallen"


def update_waywallen(folder, scaling="", props=None, mute=None):
    """Ajuste, propiedades y silencio de un fondo que ya está en pantalla: waywallen los aplica en
    vivo, sin reiniciar el fondo."""
    waywallen.apply(folder, scaling=scaling or engine_config()["scaling"], props=props, start=False)
    waywallen.set_muted(engine_config()["mute"] if mute is None else mute)


def release_ww(connector, outs):
    """Quita waywallen de esas salidas para que otro motor (o el fondo de Noctalia) se vea."""
    cur = read_json(WW_STATE, {})
    if not cur or waywallen is None:
        return
    new = {} if connector == "*" else expand(cur, outs)
    gone = [o for o in targets(connector, outs) if o in new or connector == "*"]
    for o in targets(connector, outs):
        new.pop(o, None)
    try:
        if new:
            waywallen.pause_outputs(gone)
        else:
            waywallen.stop()
    except (OSError, TimeoutError, waywallen.Error):
        pass
    write_json(WW_STATE, new)
    host_wallpaper(gone, True)


def stop_all():
    plugins, outs = enabled_plugins(), outputs()
    release_ww("*", outs)
    release_we("*", plugins)
    release_mpv("*", outs, plugins)
    return "Fondos animados detenidos"


def active_ids():
    """{id, ruta de fondo oficial o ruta de video: [salidas]} de lo que está puesto ahora."""
    active = {}
    for conn, v in read_json(WE_STATE, {}).get("assignments", {}).items():
        if isinstance(v, dict) and v.get("id"):
