def steam_libraries():
    libs = set()
    for root in STEAM_ROOTS:
        vdf = root / "steamapps/libraryfolders.vdf"
        if vdf.is_file():
            for m in re.finditer(r'"path"\s+"([^"]+)"', vdf.read_text(errors="ignore")):
                libs.add(Path(m.group(1).replace("\\\\", "\\")))
        libs.add(root)
    # Orden fijo: ~/.local/share/Steam y ~/.steam/steam son la misma carpeta y la primera que se
    # vea da la ruta de los fondos oficiales (clave de compat.json). Un set la cambiaba al azar.
    return sorted(libs)


def existing_dirs(paths):
    seen, out = set(), []
    for d in paths:
        if d.is_dir() and d.resolve() not in seen:
            seen.add(d.resolve())
            out.append(d)
    return out


def workshop_dirs():
    """Carpetas content/431960 de todas las bibliotecas de Steam."""
    extra = os.environ.get("WE_WORKSHOP_DIR")
    if extra:
        return [Path(extra)]
    return existing_dirs(lib / "steamapps/workshop/content" / WE_APPID for lib in steam_libraries())


