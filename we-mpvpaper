    # ── Steam: suscripciones y descargas ──
    def subscribe(self, it):
        if not steam_running():
            self.steam_banner.set_revealed(True)
            self.toast("Abre Steam para suscribirte")
            return
        self.downloads[it["id"]] = {"title": it["title"], "state": 0, "done": 0, "total": 0,
                                    "since": time.monotonic()}
        self.update_downloads_ui()

        def work():
            try:
                res = self.bridge.call("subscribe", id=it["id"])
                msg = None if res.get("result") == 1 else \
                    f"Steam rechazó la suscripción (código {res.get('result')})"
            except SteamError as e:
                msg = f"No se pudo suscribir: {e}"
            GLib.idle_add(self.subscribed_done, it, msg)
        threading.Thread(target=work, daemon=True).start()

    def subscribed_done(self, it, error):
        if error:
            self.downloads.pop(it["id"], None)
            self.toast(error)
        else:
            toast = Adw.Toast(title=f"Suscrito a «{it['title']}»: Steam lo está descargando", timeout=4)
            self.toasts.add_toast(toast)
            if it["id"] in self.downloads:
                self.downloads[it["id"]]["toast"] = toast
            if not self.polling:
                self.polling = True
                GLib.timeout_add(1000, self.poll_downloads)
        self.update_downloads_ui()
        return False

    def poll_downloads(self):
        """Progreso de las descargas que hace Steam (ISteamUGC::GetItemDownloadInfo)."""
        ids = list(self.downloads)
        if not ids:
            self.polling = False
            return False

        def work():
            try:
                states = self.bridge.call("state", ids=ids)["items"]
            except SteamError:
                states = None
            GLib.idle_add(self.downloads_polled, states)
        threading.Thread(target=work, daemon=True).start()
        return False

    def downloads_polled(self, states):
        for ws_id, st in (states or {}).items():
            dl = self.downloads.get(ws_id)
            if not dl:
                continue
            dl.update(state=st["state"], done=st["done"], total=st["total"])
            busy = st["state"] & (ITEM_DOWNLOADING | ITEM_PENDING | ITEM_NEEDS_UPDATE)
            if st["state"] & ITEM_INSTALLED and not busy:
                self.downloads.pop(ws_id)
                if dl.get("toast"):
                    dl["toast"].dismiss()  # si no, el aviso nuevo espera tras «lo está descargando»
                self.toast(f"«{dl['title']}» ya está en tu biblioteca")
                self.reload_pending = True
                GLib.timeout_add_seconds(1, lambda: (self.reload(), False)[1])
            elif time.monotonic() - dl["since"] > 1800:
                self.downloads.pop(ws_id)  # Steam no lo descargó en media hora: no insistir
        self.update_downloads_ui()
        if self.downloads:
            GLib.timeout_add(1000, self.poll_downloads)
        else:
            self.polling = False
        return False

    def update_downloads_ui(self):
        n = len(self.downloads)
        self.ws_page.set_badge_number(n)
        self.ws_page.set_needs_attention(n > 0)
        for ws_id in list(self.ws_cards):
            self.update_ws_card(ws_id)
        if self.split.get_show_sidebar() and self.selected and "dir" not in self.selected:
            self.update_ws_action()

    def close_idle_bridge(self):
        if not self.downloads and self.bridge.idle():
            threading.Thread(target=self.bridge.close, daemon=True).start()
        return True

    def launch_steam(self, *_):
        subprocess.Popen(["steam", "-silent"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.toast("Abriendo Steam…")
        tries = {"n": 0}

        def check():
            tries["n"] += 1
            if steam_running():
                self.steam_banner.set_revealed(False)
                return False
            return tries["n"] < 30
        GLib.timeout_add_seconds(2, check)

    def unsubscribe_action(self, _action, param):
        item = self.find(param.get_string())
        dialog = Adw.AlertDialog(
            heading=f"¿Cancelar la suscripción a «{item['title']}»?",
            body="Steam borrará sus archivos. Si está en pantalla, dejará de verse "
                 "cuando el motor se reinicie.")
        dialog.add_response("cancel", "Conservar")
        dialog.add_response("unsubscribe", "Cancelar suscripción")
        dialog.set_response_appearance("unsubscribe", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def on_response(_d, response):
            if response != "unsubscribe":
                return

            def work():
                try:
                    res = self.bridge.call("unsubscribe", id=item["id"])
                    msg = "Suscripción cancelada: Steam borrará los archivos en breve" \
                        if res.get("result") == 1 else f"Steam no lo permitió (código {res.get('result')})"
                except SteamError as e:
                    msg = f"No se pudo cancelar: {e}"
                GLib.idle_add(self.toast, msg)
            threading.Thread(target=work, daemon=True).start()
        dialog.connect("response", on_response)
        dialog.present(self)

    # ── Panel de detalles ──
    def select_item(self, item):
        self.selected = item
        self.show_detail(item)
        self.split.set_show_sidebar(True)
        card = self.cards.get(item["id"])
