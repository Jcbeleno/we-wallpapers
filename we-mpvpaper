PROP_LABELS = {
    "ui_browse_properties_scheme_color": "Color del esquema",
    "ui_browse_properties_alignment": "Alineación",
    "ui_browse_properties_play_rate": "Velocidad",
}


def prop_label(key, spec):
    text = str(spec.get("text") or key)
    if text in PROP_LABELS:
        return PROP_LABELS[text]
    if text.startswith("ui_"):
        text = key
    text = html.unescape(re.sub(r"<[^>]+>", " ", text))
    return re.sub(r"\s+", " ", text).strip()[:80] or key


def parse_color(value):
    try:
        parts = [float(p) for p in re.split(r"[\s,]+", str(value).strip()) if p][:3]
        if len(parts) == 3:
            if max(parts) > 1:
                parts = [p / 255 for p in parts]
            return parts
    except ValueError:
        pass
    return [1.0, 1.0, 1.0]


class PropsEditor:
    """Filas editables para las propiedades de un fondo (como el panel de Wallpaper Engine)."""
    EDITABLE = {"bool", "slider", "color", "combo", "textinput"}

    def __init__(self, item, on_change=None):
        self.item = item
        self.on_change = on_change or (lambda: None)
        self.saved = saved_props(item["id"])
        self.getters = {}
        self.rows = []
        specs = sorted(item["props"].items(), key=lambda kv: (kv[1].get("order", 0), kv[0]))
        for key, spec in specs:
            row = self.make_row(key, spec)
            if row:
                self.rows.append(row)

    def make_row(self, key, spec):
        kind = str(spec.get("type", "")).lower()
        if kind not in self.EDITABLE:
            return None
        title = prop_label(key, spec)
        spec = {**spec, "value": self.item["preset"].get(key, spec.get("value"))}
        value = self.saved.get(key, spec.get("value"))

        if kind == "bool":
            row = Adw.SwitchRow(title=title, active=bool(value))
            row.connect("notify::active", self.changed)
            self.getters[key] = (row.get_active, spec)
        elif kind == "slider":
            lo, hi = float(spec.get("min", 0)), float(spec.get("max", 100))
            step = float(spec.get("step") or (0.1 if spec.get("fraction") else 1))
            digits = int(spec.get("precision", 2 if spec.get("fraction") else 0))
            try:
                val = float(value)
            except (TypeError, ValueError):
                val = lo
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, min(lo, val), max(hi, val), step)
            scale.set_value(val)
            scale.set_digits(digits)
            scale.set_draw_value(True)
            scale.set_value_pos(Gtk.PositionType.LEFT)
            scale.set_hexpand(True)
            scale.set_size_request(150, -1)
            scale.set_valign(Gtk.Align.CENTER)
            scale.connect("value-changed", self.changed)
            row = Adw.ActionRow(title=title)
            row.add_suffix(scale)
            self.getters[key] = (scale.get_value, spec)
        elif kind == "color":
            r, g, b = parse_color(value)
            rgba = Gdk.RGBA()
            rgba.red, rgba.green, rgba.blue, rgba.alpha = r, g, b, 1.0
            btn = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=False), rgba=rgba,
                                        valign=Gtk.Align.CENTER)
            btn.connect("notify::rgba", self.changed)
            row = Adw.ActionRow(title=title)
            row.add_suffix(btn)

            def get_color(btn=btn):
                c = btn.get_rgba()
                return f"{c.red:.5f} {c.green:.5f} {c.blue:.5f}"
            self.getters[key] = (get_color, spec)
        elif kind == "combo":
            options = [o for o in spec.get("options") or [] if isinstance(o, dict)]
            if not options:
                return None
            labels = Gtk.StringList.new([prop_label(str(o.get("value")), {"text": o.get("label")})
                                         for o in options])
            values = [str(o.get("value")) for o in options]
            row = Adw.ComboRow(title=title, model=labels)
            if str(value) in values:
                row.set_selected(values.index(str(value)))
            row.connect("notify::selected", self.changed)
            self.getters[key] = (lambda row=row, values=values: values[row.get_selected()], spec)
        else:  # textinput
            row = Adw.EntryRow(title=title, text=str(value or ""))
            row.connect("changed", self.changed)
            self.getters[key] = (row.get_text, spec)
        return row

    def changed(self, *_):
        self.save()
        self.on_change()

    def collect(self):
        """Solo guarda lo que difiere del valor por defecto."""
        out = {}
        for key, (getter, spec) in self.getters.items():
            val = getter()
            default = spec.get("value")
            if spec.get("type") == "color":
                same = parse_color(default) == parse_color(val)
            elif isinstance(val, float):
                try:
                    same = abs(float(default) - val) < 1e-6
                except (TypeError, ValueError):
                    same = False
            else:
                same = str(val).lower() == str(default).lower()
            if not same:
                out[key] = round(val, 6) if isinstance(val, float) else val
        return out

    def save(self, props=None):
        write_json(PROPS_DIR / f"{self.item['id']}.json", self.collect() if props is None else props)


