    def ws_filters_changed(self):
        # Steam ordena las búsquedas por relevancia: el orden elegido no se usa mientras haya texto.
        searching = bool(self.ws_search.get_text().strip())
        self.ws_sort.set_sensitive(not searching)
        self.ws_sort.set_tooltip_text("Al buscar, se ordena por relevancia" if searching else "Ordenar por")
        # SearchEntry emite search-changed al crearse: no consultar hasta abrir la pestaña.
        if self.ws["started"]:
            self.ws_refresh()

    def ws_refresh(self):
        ws = self.ws
        ws.update(token=ws["token"] + 1, page=0, pages=1, loading=False, started=True)
        self.ws_cards = {}
        while (child := self.ws_flow.get_first_child()):
            self.ws_flow.remove(child)
        GLib.timeout_add_seconds(2, lambda: (gc.collect(), release_memory())[1])
        # Dos filas completas. La primera vez la rejilla aún no tiene ancho: se usa el de la ventana.
        width = self.ws_scroll.get_width() or self.get_width()
        for _ in range(2 * grid_columns(width - 44, WS_MIN)):
            sk = Thumb(*self.ws_flow.card_size)
            sk.add_css_class("we-skeleton")
            child = Gtk.FlowBoxChild(child=sk, can_focus=False, can_target=False)
            child.ws, child.pic = None, sk
            self.ws_flow.append(child)
        self.ws_stack.set_visible_child_name("grid")
        self.ws_scroll.get_vadjustment().set_value(0)
        self.ws_load_more()

    def ws_load_more(self):
        ws = self.ws
        if ws["loading"] or ws["page"] >= ws["pages"] or not ws["started"]:
            return
        ws["loading"] = True
        self.ws_more.set_visible(ws["page"] > 0)
        label, sort, days = WS_SORTS[self.ws_sort.get_selected()]
        kind = self.ws_kind.get_active_name()
        tag = self.ws_tag.get_selected()
        args = (sort, days, None if kind == "all" else kind, self.ws_search.get_text().strip(), ws["page"] + 1,
                WS_TAGS[tag - 1][0] if tag else None)
        token = ws["token"]

        def work():
            try:
                res, err = ws_browse(*args), None
            except (OSError, ValueError, KeyError) as e:
                res, err = None, e
            GLib.idle_add(self.ws_loaded, token, res, err)
        self.net.submit(work)

    def ws_loaded(self, token, res, err):
        ws = self.ws
        if token != ws["token"]:
            return False
        ws["loading"] = False
        self.ws_more.set_visible(False)
        for child in [c for c in children(self.ws_flow) if c.ws is None]:
            self.ws_flow.remove(child)
        if err:
            if ws["page"] == 0:
                self.ws_error.set_description(f"Comprueba la conexión. ({err})")
                self.ws_stack.set_visible_child_name("error")
            else:
                self.toast("No se pudieron cargar más fondos del Workshop")
            return False
        ws["page"] += 1
        ws["pages"] = res["pages"]
        for it in res["items"]:
            if it["id"] in self.ws_cards:  # la tendencia cambia entre páginas
                continue
            ws["items"][it["id"]] = it
            self.ws_flow.append(self.ws_card(it))
        if ws["page"] == 1 and not res["items"]:
            self.ws_stack.set_visible_child_name("empty")
        # Pantallas anchas: si la primera página no llena la vista no hay scroll que pida más.
        GLib.idle_add(self.ws_fill_viewport)
        return False

    def ws_fill_viewport(self):
        adj = self.ws_scroll.get_vadjustment()
        if self.views.get_visible_child_name() == "workshop" and adj.get_page_size() > 0 \
                and adj.get_upper() <= adj.get_page_size() + 40:
            self.ws_load_more()
        return False

    def ws_card(self, it):
        overlay, pic = self.card_shell(*self.ws_flow.card_size)
        preview = {"path": None}

        def thumb():
            preview["path"] = ws_preview(it)
            return thumb_texture(preview["path"], WS_SIDE, WS_SIDE)
        if it["preview_url"]:
            self.set_paintable_async(pic, thumb, self.net)  # descarga: no ocupa los hilos de miniaturas
            self.hover_animate(overlay, pic, lambda: preview["path"])

        chips = Gtk.Box(spacing=5, halign=Gtk.Align.START, valign=Gtk.Align.START, margin_top=9, margin_start=9)
        if it["kind"] in KIND_CHIP:
            chips.append(chip(KIND_CHIP[it["kind"]], it["kind"]))
        overlay.add_overlay(chips)
        overlay.badge = badge("object-select-symbolic")
        overlay.add_overlay(overlay.badge)
        overlay.progress = Gtk.ProgressBar(valign=Gtk.Align.END, visible=False)
        overlay.progress.add_css_class("we-card-progress")
        overlay.add_overlay(overlay.progress)
        sub = " · ".join(x for x in (it["author"], f"{short_num(it['subs'])} suscriptores") if x)
        overlay.fab = self.fab("folder-download-symbolic", "Suscribirse", lambda: self.ws_primary(it))
        self.card_text(overlay, it["title"], sub, overlay.fab)

        child = Gtk.FlowBoxChild(child=overlay, valign=Gtk.Align.START)
        child.ws, child.pic = it, pic
        self.ws_cards[it["id"]] = overlay
        self.update_ws_card(it["id"])
        return child

    def ws_status(self, ws_id):
        """installed | downloading | queued | None, y el progreso 0..1."""
        if ws_id in self.lib_ids:
            return "installed", 1.0
        dl = self.downloads.get(ws_id)
        if not dl:
            return None, 0.0
        if dl["done"] and dl["total"]:
            return "downloading", dl["done"] / dl["total"]
        return "queued", 0.0  # Steam aún no ha empezado a bajar bytes

    def update_ws_card(self, ws_id):
        overlay = self.ws_cards.get(ws_id)
        if not overlay:
            return
        status, frac = self.ws_status(ws_id)
        b = overlay.badge
        b.set_visible(status is not None)
        for c in ("ok", "on"):
            b.remove_css_class(c)
        if status == "installed":
            b.icon.set_from_icon_name("object-select-symbolic")
            b.label.set_label("Instalado")
            b.add_css_class("ok")
        elif status == "downloading":
            b.icon.set_from_icon_name("folder-download-symbolic")
            b.label.set_label(f"{frac:.0%}")
            b.add_css_class("on")
        elif status == "queued":
            b.icon.set_from_icon_name("content-loading-symbolic")
            b.label.set_label("En cola")
        b.label.set_visible(True)
        overlay.progress.set_visible(status in ("downloading", "queued"))
        if status == "queued":
            overlay.progress.pulse()
        else:
            overlay.progress.set_fraction(frac)
        installed = status == "installed"
        overlay.fab.set_visible(status is None or installed)
        overlay.fab.set_icon_name("media-playback-start-symbolic" if installed else "folder-download-symbolic")
        overlay.fab.set_tooltip_text("Poner de fondo" if installed else "Suscribirse")

    def ws_primary(self, it):
