def aspect_note(projection, screen):
    """Aviso si la escena tiene otra proporción que la pantalla: con «Rellenar» se recorta."""
    if not projection or not screen:
        return None
    (pw, ph), (sw, sh) = projection, screen
    scene, display = pw / ph, sw / sh
    if abs(scene - display) / display < 0.06:
        return None
    lost = 1 - min(scene, display) / max(scene, display)
    sides = "los lados" if scene > display else "arriba y abajo"
    return (f"Está hecho para {pw}×{ph} y tu pantalla es {sw}×{sh}: con «Rellenar» se recorta "
            f"un {lost:.0%} por {sides}. «Ajustar» lo muestra entero con bandas.")


def gif_still(path, at_ms=1500):
    """Fotograma de un GIF a `at_ms`: muchos empiezan en negro con un fundido."""
    anim = GdkPixbuf.PixbufAnimation.new_from_file(str(path))
    tv = GLib.TimeVal()
    tv.tv_sec, tv.tv_usec = 1000, 0
    it = anim.get_iter(tv)
    elapsed = 0
    for _ in range(500):
        delay = it.get_delay_time()
        if delay <= 0 or elapsed + delay > at_ms:
            break
        elapsed += delay
        tv.tv_sec, tv.tv_usec = 1000 + elapsed // 1000, (elapsed % 1000) * 1000
        it.advance(tv)
    return it.get_pixbuf()


def thumbnail(path, w=THUMB_W, h=THUMB_H):
    """Miniatura w×h con la imagen completa centrada; el espacio sobrante se
    rellena con una versión desenfocada y oscurecida de la misma imagen."""
    Interp = GdkPixbuf.InterpType
    with open(path, "rb") as fh:
        is_gif = fh.read(4) == b"GIF8"
    if is_gif:
        src = gif_still(path)
        iw, ih = src.get_width(), src.get_height()
        scale = min(w / iw, h / ih)
        src = src.scale_simple(max(1, round(iw * scale)), max(1, round(ih * scale)), Interp.HYPER)
    else:
        _fmt, iw, ih = GdkPixbuf.Pixbuf.get_file_info(str(path))
        scale = min(w / iw, h / ih)
        # Se decodifica ya reducida (los JPEG se escalan al decodificar): mucho más rápido.
        src = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), max(1, round(iw * scale)),
                                                      max(1, round(ih * scale)), True)
    fw, fh = src.get_width(), src.get_height()

    # Fondo: la imagen reducida a casi nada y vuelta a ampliar = desenfoque barato.
    tiny = src.scale_simple(16, max(1, round(16 * h / w)), Interp.BILINEAR)
    canvas = tiny.scale_simple(w, h, Interp.BILINEAR)
    shade = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, True, 8, w, h)
    shade.fill(0x000000FF)
    shade.composite(canvas, 0, 0, w, h, 0, 0, 1, 1, Interp.NEAREST, 110)

    x, y = (w - fw) // 2, (h - fh) // 2
    src.composite(canvas, x, y, fw, fh, x, y, 1, 1, Interp.NEAREST, 255)
    return canvas


def backdrop(path):
    """Imagen muy difuminada (reducida a 16×9 y vuelta a ampliar) para el fondo de la franja
    «En pantalla» y la cabecera del panel. Pensada para hilos de trabajo."""
    if not path:
        return None
    tiny = thumbnail(path, 16, 9).scale_simple(64, 36, GdkPixbuf.InterpType.BILINEAR)
    return Gdk.Texture.new_for_pixbuf(tiny.scale_simple(640, 360, GdkPixbuf.InterpType.BILINEAR))


def thumb_texture(path, w=THUMB_W, h=THUMB_H):
    """Textura de la miniatura, cacheada en disco. Pensada para hilos de trabajo."""
    st = path.stat()
    key = hashlib.sha1(f"{path}|{st.st_mtime_ns}|{st.st_size}|{w}x{h}".encode()).hexdigest()[:24]
    out = THUMB_DIR / f"{key}.png"
    if not out.is_file():
        THUMB_DIR.mkdir(parents=True, exist_ok=True)
        tmp = THUMB_DIR / f"{key}.{threading.get_ident()}.tmp"
        thumbnail(path, w, h).savev(str(tmp), "png", ["compression"], ["1"])
        tmp.replace(out)
    return Gdk.Texture.new_from_filename(str(out))


def video_frame(video: Path):
    """Fotograma del video (cacheado). Las vistas previas del Workshop suelen ser
    recortes cuadrados; un fotograma muestra el fondo completo en su proporción real."""
    st = video.stat()
    out = CACHE_DIR / f"{video.parent.name}-{int(st.st_mtime)}-{st.st_size}.jpg"
    if out.is_file():
        return out
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = out.with_suffix(f".{threading.get_ident()}.tmp.jpg")
    cmds = [["ffmpegthumbnailer", "-i", str(video), "-o", str(tmp), "-s", str(THUMB_W * 2),
             "-t", "15%", "-q", "8"],
            ["ffmpeg", "-v", "error", "-y", "-ss", "2", "-i", str(video), "-frames:v", "1",
             "-vf", f"scale={THUMB_W * 2}:-2", str(tmp)]]
    for cmd in cmds:
        if not shutil.which(cmd[0]):
            continue
        try:
            subprocess.run(cmd, capture_output=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if tmp.is_file() and tmp.stat().st_size:
            tmp.rename(out)
            return out
    return None


def card_image(item):
    """La imagen que mejor muestra el fondo: captura real del motor, fotograma del video
    o, en su defecto, la vista previa del autor. Puede tardar (ffmpeg): usar en hilos."""
    if item["type"] == "video" and item["file"]:
        return video_frame(item["file"]) or item["shot"] or item["preview"]
    return item["shot"] or item["preview"]


def release_memory():
    """Devuelve al sistema la memoria que glibc retiene tras soltar texturas (si no, la RSS
    se queda en el máximo alcanzado aunque ya no se use)."""
    try:
        ctypes.CDLL("libc.so.6").malloc_trim(0)
    except (OSError, AttributeError):
        pass
    return False


def prune_cache():
    """Borra miniaturas y vistas previas del Workshop que llevan un mes sin usarse."""
    old = time.time() - 30 * 86400
    for d in (THUMB_DIR, UGC_DIR):
        for f in (d.glob("*") if d.is_dir() else ()):
            try:
                if max(f.stat().st_atime, f.stat().st_mtime) < old:
                    f.unlink()
            except OSError:
                pass


