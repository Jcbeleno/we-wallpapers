def http_get(url, data=None):
    req = urllib.request.Request(url, data=data, headers={
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) WE-Wallpapers", "Accept-Encoding": "gzip"})
    with urllib.request.urlopen(req, timeout=20) as r:
        body = r.read()
        return gzip.decompress(body) if r.headers.get("Content-Encoding") == "gzip" else body


def ws_browse(sort, days, kind, text, page, tag=None):
    """Una página (30 fondos) del Workshop, con los filtros por defecto de Wallpaper Engine:
    solo fondos (no presets), clasificación «Everyone» y sin Application (no van en Linux).
    Sin clave de la API de Steam no hay endpoint de búsqueda, así que se lee el JSON que la
    web del Workshop incrusta en la página (la misma consulta que hace su JavaScript)."""
    # shortcut: depende del JSON incrustado (valve-ssr-data) de steamcommunity.com; si Steam
    # cambia la página, pasar a IPublishedFileService/QueryFiles con una clave de API.
    params = {"appid": WE_APPID, "section": "readytouseitems", "p": page,
              "browsesort": "textsearch" if text else sort,
              "requiredtags[]": ["Wallpaper", "Everyone"] + ([kind.capitalize()] if kind else [])
              + ([tag] if tag else []),
              "excludedtags[]": ["Application"]}
    if text:
        params["searchtext"] = text
    elif days:
        params["days"] = days
    page_html = http_get("https://steamcommunity.com/workshop/browse/?"
                         + urllib.parse.urlencode(params, doseq=True)).decode("utf-8", "replace")
    m = re.search(r'<script[^>]*id="valve-ssr-data"[^>]*>(.*?)</script>', page_html, re.S)
    if not m:
        raise ValueError("la página del Workshop no trae datos")
    queries = json.loads(json.loads(m.group(1))["renderContext"]["queryData"])["queries"]
    browse, players = None, {}
    for q in queries:
        key, data = q.get("queryKey") or [None], (q.get("state") or {}).get("data")
        if key[0] == "workshop_browse":
            browse = data
        elif key[0] == "PlayerLinkDetails" and len(key) > 1 and isinstance(data, dict):
            players[str(key[1])] = (data.get("public_data") or {}).get("persona_name")
    if not isinstance(browse, dict) or not isinstance(browse.get("results"), list):
        raise ValueError("la página del Workshop no trae resultados")
    items = [ws_item(r, players) for r in browse["results"] if r.get("publishedfileid")]
    return {"items": items, "pages": int(browse.get("total_pages") or 1),
            "total": int(browse.get("total_count") or len(items))}


def ws_item(r, players):
    tags = [str(t.get("tag")) for t in r.get("tags") or [] if isinstance(t, dict)]
    res = next((t for t in tags if re.fullmatch(r"\d+ x \d+", t)), None)
