KIND_CHIP = {"video": "VIDEO", "scene": "ESCENA", "web": "WEB", "application": "APP"}


def chip(text, *classes):
    lbl = Gtk.Label(label=text, valign=Gtk.Align.START, halign=Gtk.Align.START)
    lbl.add_css_class("we-chip")
    for c in classes:
        lbl.add_css_class(c)
    return lbl


def item_chips(item, box, full=False):
    """Chips de tipo y estado de un fondo de la biblioteca."""
    can_play = playable(item)
    if item["type"] in KIND_CHIP:
        box.append(chip(KIND_CHIP[item["type"]], item["type"]))
    if item["preset"]:
        box.append(chip("PRESET", "preset"))
    if item["source"] == "official":
        box.append(chip("OFICIAL"))
    if item["compat"] == "fail" or not can_play:
        box.append(chip("NO COMPATIBLE", "bad"))
    elif item["compat"] == "partial":
        box.append(chip("PARCIAL", "preset"))
    elif full and item["compat"] == "ok":
        box.append(chip("PROBADO", "ok"))


def badge(icon, text=None, *classes):
    box = Gtk.Box(spacing=5, halign=Gtk.Align.END, valign=Gtk.Align.START, margin_top=8, margin_end=8)
    box.add_css_class("we-badge")
    for c in classes:
        box.add_css_class(c)
    box.icon = Gtk.Image(icon_name=icon, pixel_size=14)
    box.label = Gtk.Label(label=text or "", visible=bool(text))
    box.append(box.icon)
    box.append(box.label)
    return box


def grid_columns(avail, min_w, gap=18):
    return max(1, int((avail + gap) // (min_w + gap)))


def children(widget):
    child = widget.get_first_child()
    while child:
        yield child
        child = child.get_next_sibling()


def warning_row(text, level="error"):
    row = Gtk.Box(spacing=8, hexpand=True, valign=Gtk.Align.CENTER)
    row.add_css_class(level)
    row.append(Gtk.Image(icon_name="dialog-warning-symbolic", valign=Gtk.Align.START))
    lbl = Gtk.Label(label=text, xalign=0, wrap=True, hexpand=True)
    lbl.add_css_class("caption")
    row.append(lbl)
    return row


def wrap_tags(tags):
    wrap = Adw.WrapBox(child_spacing=6, line_spacing=6)
    for t in tags:
        lbl = Gtk.Label(label=str(t))
        lbl.add_css_class("we-tag")
        wrap.append(lbl)
    return wrap


class Thumb(Gtk.Picture):
    """Miniatura del tamaño exacto que fija la rejilla, no el de su textura (Gtk.Picture
    pediría el de la textura y FlowBox recortaría la proporción al repartir el ancho)."""
    __gtype_name__ = "WeThumb"

    def __init__(self, w, h):
        super().__init__(can_shrink=True, content_fit=Gtk.ContentFit.COVER)
        self.size = (w, h)

    def set_size(self, w, h):
        if (w, h) != self.size:
            self.size = (w, h)
            self.queue_resize()

    def do_measure(self, orientation, _for_size):
        v = self.size[0] if orientation == Gtk.Orientation.HORIZONTAL else self.size[1]
        return v, v, -1, -1


class GifPlayer:
    """Anima un GIF en un Gtk.Picture (las vistas previas del Workshop lo son).
    GTK no anima GIF por sí solo; GdkPixbufAnimation da los fotogramas."""

    def __init__(self, pic):
        self.pic = pic
        self.it = None
        self.source = 0
        self.token = 0

    def play(self, path, pool):
        self.stop()
        token = self.token

        def load():
            try:
                anim = GdkPixbuf.PixbufAnimation.new_from_file(str(path))
            except GLib.Error:
                return
            if not anim.is_static_image():
                GLib.idle_add(self._start, anim, token)
        pool.submit(load)

    def _start(self, anim, token):
        if token == self.token:
            self.it = anim.get_iter(None)
            self._step()
        return False

    def _step(self):
        self.pic.set_paintable(Gdk.Texture.new_for_pixbuf(self.it.get_pixbuf()))
        delay = self.it.get_delay_time()
        self.source = GLib.timeout_add(max(20, delay), self._advance) if delay > 0 else 0
        return False

    def _advance(self):
        self.it.advance(None)
        return self._step()

    def stop(self):
        self.token += 1
        if self.source:
            GLib.source_remove(self.source)
        self.source, self.it = 0, None


