    def reload(self):
        self.reload_pending = False
        self.items = load_items()
        GLib.timeout_add_seconds(2, lambda: (gc.collect(), release_memory())[1])
        self.lib_ids = {i["id"] for i in self.items if i["source"] == "workshop"}
        self.cards = {}
        while (child := self.flow.get_first_child()):
            self.flow.remove(child)
        for item in self.items:
            self.flow.append(self.card(item))
        self.update_lib_stack()
        self.refresh_active()
        self.watch_dirs()
        for ws_id in self.ws_cards:
            self.update_ws_card(ws_id)
        if self.selected and self.split.get_show_sidebar():
            # Un fondo del Workshop recién descargado pasa a mostrarse como de la biblioteca.
            sel = self.lib_item(self.selected["id"])
            if sel:
                self.select_item(sel)
            elif "dir" not in self.selected:  # sigue siendo un fondo del Workshop
                self.show_ws_detail(self.selected)
            else:
                self.split.set_show_sidebar(False)

    def watch_dirs(self):
        for mon in self.monitors:
            mon.cancel()
        self.monitors = []
        for d in workshop_dirs():
            mon = Gio.File.new_for_path(str(d)).monitor_directory(Gio.FileMonitorFlags.NONE, None)
            mon.set_rate_limit(3000)
            mon.connect("changed", self.on_dir_changed)
            self.monitors.append(mon)

    def on_dir_changed(self, _mon, _f, _o, event):
        if event in (Gio.FileMonitorEvent.CREATED, Gio.FileMonitorEvent.DELETED,
                     Gio.FileMonitorEvent.MOVED_IN, Gio.FileMonitorEvent.MOVED_OUT) \
                and not self.reload_pending:
            self.reload_pending = True
            GLib.timeout_add_seconds(2, lambda: (self.reload(), False)[1])

    def filter(self, child):
        item = child.item
        kind = self.kind.get_active_name()
        if kind in ("video", "scene", "web") and item["type"] != kind:
            return False
        if kind == "ok" and not (playable(item) and item["compat"] != "fail"):
            return False
        q = self.lib_search.get_text().strip().lower()
        return not q or q in item["title"].lower() or any(q in str(t).lower() for t in item["tags"])

    def refilter(self):
        self.flow.invalidate_filter()
        self.update_lib_stack()

    def sort_key(self, item):
        mode = LIB_SORTS[self.lib_sort.get_selected()][0]
        title = item["title"].lower()
        if mode == "title":
            return (title,)
        if mode == "added":
            return (-item["added"], title)
        if mode == "used":
            return (-self.history.get(item["id"], 0), title)
        works = (item["compat"] == "fail" or not playable(item), item["compat"] == "partial")
        if mode == "type":
            return (KIND_ORDER.get(item["type"], 9), *works, title)
        return (*works, title)

    def on_lib_sort(self, *_):
        self.ui["lib_sort"] = LIB_SORTS[self.lib_sort.get_selected()][0]
        write_json(UI_FILE, self.ui)
        self.flow.invalidate_sort()

    def update_lib_stack(self):
        if not self.items:
            self.lib_stack.set_visible_child_name("empty")
            self.lib_count.set_label("")
            return
        shown = sum(1 for c in children(self.flow) if self.filter(c))
        total = len(self.items)
        self.lib_count.set_label(f"{total} fondos" if shown == total else f"{shown} de {total}")
        self.lib_stack.set_visible_child_name("grid" if shown else "none")

    @staticmethod
    def item_key(item):
        return str(item["file"]) if item["type"] == "video" and item["file"] else item["target"]

    def refresh_active(self):
        active = active_ids()
        for card, item in self.cards.values():
            on = None if item["preset"] else active.get(self.item_key(item))
            card.mark.set_visible(bool(on))
        self.build_now_playing(active)

    def build_now_playing(self, active):
        while (c := self.now_box.get_first_child()):
            self.now_box.remove(c)
        by_key = {self.item_key(i): i for i in self.items if not i["preset"]}
        pills = []
        for key, conns in active.items():
            item = by_key.get(key)
            title = item["title"] if item else Path(key).name
            where = "Todas las pantallas" if "*" in conns else " · ".join(sorted(conns))
            pill = Gtk.Box(spacing=10)
            pill.add_css_class("we-now-pill")
            pic = Gtk.Picture(can_shrink=True, content_fit=Gtk.ContentFit.COVER)
            pic.set_size_request(80, 45)
            pic.add_css_class("we-now-thumb")
            pic.add_css_class("we-fade")
            if item:
                self.load_thumb(pic, item, 160, 90)
            pill.append(pic)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
            t = Gtk.Label(label=title, xalign=0, ellipsize=3, max_width_chars=28)
            t.add_css_class("heading")
            w = Gtk.Label(label=where, xalign=0)
            w.add_css_class("dim-label")
            w.add_css_class("we-now-label")
            text.append(t)
            text.append(w)
            pill.append(text)
            if item:
                click = Gtk.GestureClick()
                click.connect("released", lambda *_a, item=item: self.select_item(item))
                pill.add_controller(click)
                pill.set_cursor_from_name("pointer")
                pill.set_tooltip_text("Ver detalles")
            pills.append(pill)

        self.now.set_visible(bool(pills))
        lead = next((by_key[k] for k in active if k in by_key), None)
        if (lead and lead["id"]) != self.now_lead:
            self.now_lead = lead and lead["id"]
            self.now_bg.remove_css_class("we-in")
            if lead:
                self.set_paintable_async(self.now_bg, lambda: backdrop(card_image(lead)))
        if pills:
            head = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER, margin_start=4)
            dot = Gtk.Box(valign=Gtk.Align.CENTER)
            dot.add_css_class("we-live")
            head.append(dot)
            lbl = Gtk.Label(label="En pantalla")
            lbl.add_css_class("heading")
            head.append(lbl)
            self.now_box.append(head)
            for p in pills:
                self.now_box.append(p)
            stop = Gtk.Button(icon_name="media-playback-stop-symbolic", tooltip_text="Detener fondo animado",
                              valign=Gtk.Align.CENTER, hexpand=True, halign=Gtk.Align.END)
            stop.add_css_class("circular")
            stop.connect("clicked", self.stop)
            self.now_box.append(stop)

    # ── Tarjetas ──
    def card_shell(self, w, h, dim=False):
        """Tarjeta con imagen, sombreado inferior y capas. Devuelve (overlay, picture)."""
        overlay = Gtk.Overlay()
        overlay.add_css_class("we-card")
        overlay.set_overflow(Gtk.Overflow.HIDDEN)
        pic = Thumb(w, h)
        pic.add_css_class("we-thumb")
        pic.add_css_class("we-fade")
        if dim:
            pic.add_css_class("we-dim")
        overlay.set_child(pic)
