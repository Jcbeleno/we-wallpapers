    # ── Acciones ──
    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=4))

    def connector(self):
        sel = self.out_row.get_selected() if self.outs and hasattr(self, "out_row") else 0
        return "*" if sel == 0 or not self.outs else self.outs[sel - 1]

    def run_bg(self, label, fn, *args):
        if label:
            self.toast(label)

        def work():
            try:
                msg = fn(*args)
            except subprocess.CalledProcessError as e:
                msg = f"Error: {(e.stderr or e.stdout or str(e)).strip()[:160]}"
            except Exception as e:  # noqa: BLE001
                msg = f"Error: {e}"
            GLib.idle_add(self.toast, msg)
            GLib.timeout_add_seconds(1, lambda: (self.refresh_active(), False)[1])
            GLib.timeout_add_seconds(4, lambda: (self.refresh_active(), False)[1])

        threading.Thread(target=work, daemon=True).start()

    def apply(self, item, from_sidebar=False):
        conn = self.connector() if from_sidebar else "*"
        if from_sidebar and self.editor and self.selected is item:
            self.editor.save()
        self.history[item["id"]] = int(time.time())
        write_json(HISTORY_FILE, self.history)
        if LIB_SORTS[self.lib_sort.get_selected()][0] == "used":
            self.flow.invalidate_sort()
        if engine_for(item) == "ww":
            props = {**item["preset"], **saved_props(item["id"])}
            self.run_bg(f"Aplicando «{item['title']}»…", apply_waywallen, item["folder"], conn,
                        self.item_key(item), props, saved_scaling(item["id"]), saved_mute(item["id"]))
        elif item["type"] == "video":
            self.run_bg(f"Aplicando «{item['title']}»…", apply_video, item["file"], conn,
                        saved_scaling(item["id"]))
        else:
            note = " (falló en la prueba, puede no funcionar)" if item["compat"] == "fail" else ""
            props = {**item["preset"], **saved_props(item["id"])}
            self.run_bg(f"Aplicando «{item['title']}»…{note}", apply_scene, item["target"], conn, props,
                        item["type"], saved_scaling(item["id"]), saved_mute(item["id"]))

    def live_apply(self, item):
        """Si el fondo está en pantalla, lo vuelve a poner con los cambios. Espera a que se deje
        de tocar (un deslizador cambia muchas veces por segundo y cada cambio reinicia el motor)."""
        if self.live_src:
            GLib.source_remove(self.live_src)
        self.live_src = GLib.timeout_add(800, self._live_apply, item)

    def _live_apply(self, item):
        self.live_src = 0
        conns = None if item["preset"] else active_ids().get(self.item_key(item))
        ww_conns = {o for o, key in read_json(WW_STATE, {}).items() if key == self.item_key(item)}
        if conns and ww_conns:  # waywallen cambia ajuste y propiedades en vivo
            props = {**item["preset"], **saved_props(item["id"])}
            self.run_bg(None, lambda: (update_waywallen(item["folder"], saved_scaling(item["id"]), props,
                                                        saved_mute(item["id"])), "Cambios aplicados en pantalla")[1])
        elif conns and item["type"] == "video":  # mpv cambia el ajuste en caliente, sin reiniciar el video
            def video_work():
                for conn in conns:
                    set_video_scaling(conn, saved_scaling(item["id"]), wait=1)
                return "Cambios aplicados en pantalla"
            self.run_bg(None, video_work)
        elif conns:
            where = ["*"] if "*" in conns or set(self.outs) <= set(conns) else conns
            props = {**item["preset"], **saved_props(item["id"])}

            def work():
                for conn in where:
                    apply_scene(item["target"], conn, props, item["type"], saved_scaling(item["id"]),
                                saved_mute(item["id"]))
                return "Cambios aplicados en pantalla"
            self.run_bg(None, work)
        return False

    def shuffle(self, *_):
        active = active_ids()
        pool = [c.item for c in children(self.flow) if self.filter(c) and playable(c.item)
                and c.item["compat"] != "fail" and self.item_key(c.item) not in active]
        if not pool:
            return self.toast("No hay otro fondo compatible entre los que se ven")
        self.apply(random.choice(pool))

    def preview(self, item):
        if self.editor and self.selected is item:
            self.editor.save()
        engine = shutil.which("linux-wallpaperengine-web") or shutil.which("linux-wallpaperengine")
        if not engine:
            return self.toast("linux-wallpaperengine no está instalado")
        cmd = [engine, "--window", "0x0x1280x720"]
        for k, v in {**item["preset"], **saved_props(item["id"])}.items():
            cmd += ["--set-property", f"{k}={int(v) if isinstance(v, bool) else v}"]
        subprocess.Popen(cmd + [item["target"]], start_new_session=True, cwd=str(HOME),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.toast("Abriendo vista previa en una ventana…")

    def find(self, item_id):
        return next(i for i in self.items if i["id"] == item_id)

    def apply_action(self, _action, param):
        self.apply(self.find(param.get_string()))

    def preview_action(self, _action, param):
        self.preview(self.find(param.get_string()))

    def stop(self, *_):
        self.run_bg("Deteniendo…", stop_all)

    def engine_settings(self, *_):
        """Ajustes de linux-wallpaperengine (escenas y web). Se aplican solos al cambiarlos."""
        cfg = engine_config()
        dlg = Adw.PreferencesDialog(title="Ajustes", search_enabled=False)
        page = Adw.PreferencesPage(title="Ajustes", icon_name="preferences-system-symbolic")
        dlg.add(page)
        pending = {"src": 0}

        def commit():
            pending["src"] = 0
            snapshot = dict(cfg)

            def work():
                try:
                    save_engine_config(snapshot)
                    msg = "Ajustes aplicados" if read_json(WE_STATE, {}).get("assignments") else "Ajustes guardados"
                except (OSError, subprocess.SubprocessError) as e:
                    msg = f"No se pudieron aplicar: {e}"
                GLib.idle_add(lambda: (dlg.add_toast(Adw.Toast(title=msg, timeout=2)), False)[1])
            threading.Thread(target=work, daemon=True).start()
            return False

        def changed(key, value):
            if cfg[key] == value:
                return
            cfg[key] = value
            if pending["src"]:
                GLib.source_remove(pending["src"])
            pending["src"] = GLib.timeout_add(700, commit)  # cada cambio reinicia los fondos

        def switch(group, key, title, subtitle=None):
            row = Adw.SwitchRow(title=title, subtitle=subtitle or "", active=bool(cfg[key]))
            row.connect("notify::active", lambda r, *_: changed(key, r.get_active()))
            group.add(row)
            return row

        def combo(group, key, title, options, subtitle=None):
            keys = [k for k, _label in options]
            row = Adw.ComboRow(title=title, subtitle=subtitle or "",
                               model=Gtk.StringList.new([label for _k, label in options]),
                               selected=keys.index(cfg[key]) if cfg[key] in keys else 0)
            row.connect("notify::selected", lambda r, *_: changed(key, keys[r.get_selected()]))
            group.add(row)

        perf = Adw.PreferencesGroup(title="Rendimiento",
                                    description="Afectan a las escenas y los fondos web.")
        fps = Adw.SpinRow.new_with_range(5, 240, 5)
        fps.set_title("FPS máximos")
        fps.set_subtitle("Menos FPS, menos CPU y GPU")
        fps.set_value(int(cfg["fps"]))
        fps.connect("notify::value", lambda r, *_: changed("fps", int(r.get_value())))
        perf.add(fps)
        switch(perf, "particles", "Partículas", "Lluvia, chispas, nieve… son lo que más GPU gasta")
        combo(perf, "fullscreen_pause", "Pausar al haber pantalla completa", FULLSCREEN_PAUSE)
        page.add(perf)

        screen = Adw.PreferencesGroup(title="Pantalla")
        combo(screen, "scaling", "Ajuste predeterminado", ENGINE_SCALINGS,
              "Cada fondo puede elegir el suyo en su panel")
        page.add(screen)

        sound = Adw.PreferencesGroup(title="Sonido")
        mute = switch(sound, "mute", "Silenciar los fondos")
        vol_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
        vol_scale.set_value(int(cfg["volume"]))
        vol_scale.set_draw_value(True)
        vol_scale.set_value_pos(Gtk.PositionType.LEFT)
        vol_scale.set_hexpand(True)
        vol_scale.set_size_request(180, -1)
        vol_scale.set_valign(Gtk.Align.CENTER)
        vol_scale.connect("value-changed", lambda sc: changed("volume", int(sc.get_value())))
        volume = Adw.ActionRow(title="Volumen")
        volume.add_suffix(vol_scale)
        sound.add(volume)
        automute = switch(sound, "automute", "Bajar el sonido si otra app suena")
        switch(sound, "audio_reactive", "Reaccionar al audio",
               "Visualizadores y efectos que se mueven con la música del sistema")
        for row in (volume, automute):
            mute.bind_property("active", row, "visible", GObject.BindingFlags.SYNC_CREATE
                               | GObject.BindingFlags.INVERT_BOOLEAN)
        page.add(sound)

        touch = Adw.PreferencesGroup(title="Interacción")
        switch(touch, "mouse", "Responder al ratón")
        switch(touch, "parallax", "Efecto parallax", "Las capas se desplazan un poco al mover el ratón")
        page.add(touch)

        videos = Adw.PreferencesGroup(
            title="Videos", description="Los videos los pone el plugin oficial noctalia/mpvpaper; "
                                        "su sonido y decodificación se ajustan en Noctalia.")
        open_mpv = Adw.ActionRow(title="Ajustes de mpvpaper en Noctalia", activatable=True)
        open_mpv.add_suffix(Gtk.Image(icon_name="adw-external-link-symbolic"))

        def open_noctalia(*_):
            try:
                nmsg("settings-open-plugin", MPV_PLUGIN)
            except (OSError, subprocess.SubprocessError):
                dlg.add_toast(Adw.Toast(title="No se pudieron abrir los ajustes de Noctalia"))
        open_mpv.connect("activated", open_noctalia)
        videos.add(open_mpv)
        page.add(videos)

        def closed(*_):
            if pending["src"]:  # aplicar lo que quedaba pendiente
                GLib.source_remove(pending["src"])
                commit()
            if self.selected and "dir" in self.selected and self.split.get_show_sidebar():
                self.show_detail(self.selected)  # el «Predeterminado» del panel cambia
        dlg.connect("closed", closed)
        dlg.present(self)

    def run_compat(self, *_):
        self.toast("Probando fondos nuevos; puede tardar unos minutos…")

        def work():
            subprocess.run([sys.executable, "-I", str(COMPAT_TEST)], capture_output=True)
            GLib.idle_add(self.reload)
            GLib.idle_add(self.toast, "Prueba de compatibilidad terminada")

        threading.Thread(target=work, daemon=True).start()

    def copy_item(self, _action, param):
        item = self.find(param.get_string())
        if not item["file"]:
            return self.toast("Este fondo no es un video")
        VIDEO_DIR.mkdir(parents=True, exist_ok=True)
        safe = re.sub(r'[\\/:*?"<>|]+', "_", item["title"]).strip() or item["id"]
        dest = VIDEO_DIR / f"{safe}{item['file'].suffix}"
        shutil.copy2(item["file"], dest)
        self.toast(f"Copiado a {dest.name}")

    def open_folder(self, _action, param):
        Gio.AppInfo.launch_default_for_uri(self.find(param.get_string())["dir"].as_uri(), None)

    def workshop_page(self, _action, param):
        self.steam(f"steam://url/CommunityFilePage/{param.get_string()}",
                   f"https://steamcommunity.com/sharedfiles/filedetails/?id={param.get_string()}")

    def open_workshop(self, *_):
        self.steam(f"steam://url/SteamWorkshopPage/{WE_APPID}",
                   f"https://steamcommunity.com/app/{WE_APPID}/workshop/")

    @staticmethod
    def steam(uri, web):
        if shutil.which("steam"):
            subprocess.Popen(["steam", uri], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            Gio.AppInfo.launch_default_for_uri(web, None)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            provider = Gtk.CssProvider()
            provider.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            win = Window(self)
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
