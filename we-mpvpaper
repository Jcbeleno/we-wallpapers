    def card(self, item):
        can_play = playable(item)
        overlay, pic = self.card_shell(*self.flow.card_size, dim=not can_play or item["compat"] == "fail")
        self.load_thumb(pic, item)
        if not item["shot"] and item["preview"] and item["preview"].suffix.lower() == ".gif" \
                and item["type"] != "video":
            self.hover_animate(overlay, pic, item["preview"])

        chips = Gtk.Box(spacing=5, halign=Gtk.Align.START, valign=Gtk.Align.START, margin_top=9, margin_start=9)
        item_chips(item, chips)
        overlay.add_overlay(chips)
        mark = badge("object-select-symbolic", "En pantalla", "on")
        mark.set_visible(False)
        overlay.add_overlay(mark)
        self.card_text(overlay, item["title"], ", ".join(str(t) for t in item["tags"][:3]),
                       self.fab("media-playback-start-symbolic", "Poner de fondo",
                                lambda: self.apply(item)) if can_play else None)

        child = Gtk.FlowBoxChild(child=overlay, valign=Gtk.Align.START)
        child.item, child.pic = item, pic
        overlay.mark = mark
        self.cards[item["id"]] = (overlay, item)

        # doble clic = aplicar
        dbl = Gtk.GestureClick()
        dbl.connect("pressed", lambda g, n, *_: n == 2 and can_play and self.apply(item))
        overlay.add_controller(dbl)
        return child

    def load_thumb(self, pic, item, w=THUMB_W, h=THUMB_H):
        """Miniatura en segundo plano (cacheada en disco): la ventana se abre al instante."""
        def work():
            image = card_image(item)
            return image and thumb_texture(image, w, h)
        self.set_paintable_async(pic, work)

    def set_paintable_async(self, pic, work, pool=None):
        def run():
            try:
                tex = work()
            except (GLib.Error, OSError, ValueError, TypeError, ZeroDivisionError):
                return
            if tex:
                GLib.idle_add(self.show_texture, pic, tex)
        (pool or self.pool).submit(run)

    @staticmethod
    def show_texture(pic, tex):
        pic.set_paintable(tex)
        pic.add_css_class("we-in")  # .we-fade: aparece con un fundido en vez de saltar
        return False

    def hover_animate(self, overlay, pic, gif_path_fn):
        """Al dejar el ratón sobre la tarjeta, su vista previa GIF se mueve."""
        player = GifPlayer(pic)
        motion = Gtk.EventControllerMotion()
        state = {"timer": 0, "still": None}

        def start():
            state["timer"] = 0
            path = gif_path_fn() if callable(gif_path_fn) else gif_path_fn
            if path:
                state["still"] = pic.get_paintable()
                player.play(path, self.pool)
            return False

        def enter(*_):
            state["timer"] = GLib.timeout_add(220, start)

        def leave(*_):
            if state["timer"]:
                GLib.source_remove(state["timer"])
                state["timer"] = 0
            player.stop()
            if state["still"] is not None:
                pic.set_paintable(state["still"])
                state["still"] = None
        motion.connect("enter", enter)
        motion.connect("leave", leave)
        overlay.add_controller(motion)

    @staticmethod
    def fit_grid(flow, scroller, min_w, ratio, gap=18, pad=44):
        """Tantas columnas como quepan con tarjetas de al menos min_w, repartiendo el ancho
        sobrante entre ellas y manteniendo su proporción. pad = relleno lateral de .we-grid."""
        flow.card_size = (min_w, round(min_w / ratio))
        flow.set_homogeneous(True)
        adj = scroller.get_hadjustment()

        def changed(*_):
            avail = adj.get_page_size() - pad
            if avail <= 0:
                return
            n = grid_columns(avail, min_w, gap)
            w = int((avail - (n - 1) * gap) // n)
            if (w, round(w / ratio)) == flow.card_size:
                return
            flow.card_size = (w, round(w / ratio))
            flow.set_min_children_per_line(n)
            flow.set_max_children_per_line(n)
            for child in children(flow):
                child.pic.set_size(*flow.card_size)
        adj.connect("changed", changed)

